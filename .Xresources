URxvt.font:           xft:DejaVu Sans Mono:size=12:style=Regular
URxvt.boldFont:       xft:DejaVu Sans Mono:size=12:style=Medium
URxvt.italicFont:     xft:DejaVu Sans Mono:size=12:style=Italic
URxvt.boldItalicFont: xft:DejaVu Sans Mono:size=12:style=Medium Italic

! Fix default rxvt copy/paste keybindings
URxvt.iso14755: false
URxvt.iso14755_52: false
URxvt.keysym.Control-Shift-C:   eval:selection_to_clipboard
URxvt.keysym.Control-Shift-V:   eval:paste_clipboard
URxvt.keysym.Control-Meta-c: builtin-string:
URxvt.keysym.Control-Meta-v: builtin-string:

URxvt.saveLines: 2048

URxvt.scrollBar: false

! fix prompt placement
URxvt.geometry: 174x47

URxvt.background: black
URxvt.foreground: lightgrey

! black
URxvt*color0  : #2E3436
URxvt*color8  : #555753
! red
URxvt*color1  : #CC0000
URxvt*color9  : #EF2929
! green
URxvt*color2  : #4E9A06
URxvt*color10 : #8AE234
! yellow
URxvt*color3  : #C4A000
URxvt*color11 : #FCE94F
! blue
URxvt*color4  : #3465A4
URxvt*color12 : #729FCF
! magenta
URxvt*color5  : #EF33C0
URxvt*color13 : #EE38DA
! cyan
URxvt*color6  : #04B5B8
URxvt*color14 : #34E2E2
! white
URxvt*color7  : #D3D7CF
URxvt*color15 : #EEEEEC

Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.antialias: 1
Xft.rgba: rgb
Xft.dpi: 96
